<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Control ID="RecoveryNode" number_of_retries="3">
            <ReactiveFallback>
                <Sequence name="P1_DynamicObstacle">
                    <Condition ID="DynamicObstacleCondition" sensor_data="{detected_obstacle}"/>
                    <Action ID="Wait" wait_duration="0.5"/>
                </Sequence>
                <Sequence name="P2_StaticObstacle">
                    <Condition ID="StaticObstacleCondition" is_static="{is_static_obstacle}"/>
                    <Fallback>
                        <Sequence>
                            <Condition ID="TwoWayRoadCondition" is_two_way="{is_two_way_road}"/>
                            <Action ID="Wait" wait_duration="1.0"/>
                        </Sequence>
                        <Sequence>
                            <Action ID="CalculateLaneChangeAction" current_pos="{current_pose}" temp_goal="{temp_goal}"/>
                            <Action ID="DriveToGoal" goal="{temp_goal}"/>
                        </Sequence>
                    </Fallback>
                </Sequence>
                <Sequence>
                    <Condition ID="TrafficLightCondition" detected_light="{detected_light}"/>
                    <Action ID="Wait" wait_duration="0.5"/>
                </Sequence>
                <Fallback name="P4_TrafficSigns">
                    <Sequence>
                        <Condition ID="LaneRegulationCondition" sign_detected="{sign_lane_reg}"/>
                        <Action ID="LaneRegulationAction" current_pos="{current_pose}" direction="{sign_lane_reg}" temp_goal="{temp_goal}"/>
                        <Action ID="DriveToGoal" goal="{temp_goal}"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="StopSignCondition" sign_detected="{sign_stop}"/>
                        <Action ID="StopSignAction"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="BusStopCondition" sign_detected="{sign_bus_stop}"/>
                        <Action ID="BusStopAction"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="PedestrianCrossingCondition" sign_detected="{sign_pedestrian}"/>
                        <Action ID="SlowDownAction"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="RoundaboutCondition" sign_detected="{sign_roundabout}"/>
                        <Action ID="RoundaboutAction"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="TunnelCondition" sign_detected="{sign_tunnel}"/>
                        <Action ID="TunnelAction"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="PassByCondition" sign_detected="{sign_pass_by}"/>
                        <Action ID="PassByAction" direction="{sign_pass_by}"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="NoEntryCondition" sign_detected="{sign_no_entry}"/>
                        <Action ID="NoEntryAction" current_vertex="{current_vertex}" next_vertex="{next_vertex}"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="ForbiddenTurnCondition" sign_detected="{sign_forbidden}"/>
                        <Action ID="ForbiddenTurnAction" current_vertex="{current_vertex}" next_vertex="{next_vertex}"/>
                    </Sequence>
                    <Sequence>
                        <Condition ID="MandatoryTurnCondition" sign_detected="{sign_mandatory}"/>
                        <Action ID="MandatoryTurnAction" current_vertex="{current_vertex}" next_vertex="{next_vertex}" sign_data="{sign_mandatory}"/>
                    </Sequence>
                </Fallback>
                <Action ID="NavigateToPose" behavior_tree="" goal="{free_roam_goal}"/>
            </ReactiveFallback>
            <Sequence>
                <Condition ID="IsStuck"/>
                <Action ID="BackUp" backup_dist="0.3" backup_speed="0.05" time_allowance="10"/>
                <Action ID="Spin" spin_dist="1.57" time_allowance="10"/>
            </Sequence>
        </Control>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="BackUp">
            <inout_port name="backup_dist"/>
            <inout_port name="backup_speed"/>
            <inout_port name="time_allowance"/>
        </Action>
        <Action ID="BusStopAction"/>
        <Condition ID="BusStopCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Action ID="CalculateLaneChangeAction">
            <inout_port name="current_pos"/>
            <inout_port name="temp_goal"/>
        </Action>
        <Action ID="DriveToGoal">
            <inout_port name="goal"/>
        </Action>
        <Condition ID="DynamicObstacleCondition">
            <inout_port name="sensor_data"/>
        </Condition>
        <Action ID="ForbiddenTurnAction">
            <inout_port name="current_vertex"/>
            <inout_port name="next_vertex"/>
        </Action>
        <Condition ID="ForbiddenTurnCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Condition ID="IsStuck"/>
        <Action ID="LaneRegulationAction">
            <inout_port name="current_pos"/>
            <inout_port name="direction"/>
            <inout_port name="temp_goal"/>
        </Action>
        <Condition ID="LaneRegulationCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Action ID="MandatoryTurnAction">
            <inout_port name="current_vertex"/>
            <inout_port name="next_vertex"/>
            <inout_port name="sign_data"/>
        </Action>
        <Condition ID="MandatoryTurnCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Action ID="NavigateToPose">
            <inout_port name="behavior_tree"/>
            <inout_port name="goal"/>
        </Action>
        <Action ID="NoEntryAction">
            <inout_port name="current_vertex"/>
            <inout_port name="next_vertex"/>
        </Action>
        <Condition ID="NoEntryCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Action ID="PassByAction">
            <inout_port name="direction"/>
        </Action>
        <Condition ID="PassByCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Condition ID="PedestrianCrossingCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Control ID="RecoveryNode">
            <inout_port name="number_of_retries"/>
        </Control>
        <Action ID="RoundaboutAction"/>
        <Condition ID="RoundaboutCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Action ID="SlowDownAction"/>
        <Action ID="Spin">
            <inout_port name="spin_dist"/>
            <inout_port name="time_allowance"/>
        </Action>
        <Condition ID="StaticObstacleCondition">
            <inout_port name="is_static"/>
        </Condition>
        <Action ID="StopSignAction"/>
        <Condition ID="StopSignCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Condition ID="TrafficLightCondition">
            <inout_port name="detected_light"/>
        </Condition>
        <Action ID="TunnelAction"/>
        <Condition ID="TunnelCondition">
            <inout_port name="sign_detected"/>
        </Condition>
        <Condition ID="TwoWayRoadCondition">
            <inout_port name="is_two_way"/>
        </Condition>
        <Action ID="Wait">
            <inout_port name="wait_duration"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
